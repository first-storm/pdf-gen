# Copy to .env and fill in real values.

# API keys.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# OpenAI-compatible endpoints can use OPENAI_API_KEY (or GEMINI_API_KEY as fallback).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# OpenAI response_format usage (json_object); set to 0/false/off/none to disable.
GEMINI_PDF_AGENT_OPENAI_RESPONSE_FORMAT=1
# Retry count for OpenAI-compatible HTTP failures (429/5xx).
GEMINI_PDF_AGENT_OPENAI_RETRIES=2

# Server config.
# Path to config.json (optional).
GEMINI_PDF_AGENT_CONFIG=/path/to/config.json
# Workdir root for server runs.
GEMINI_PDF_AGENT_WORKDIR=server_runs
# CORS origin regex; ignored when PDGEN_DEV=TRUE.
GEMINI_PDF_AGENT_CORS_ORIGIN_REGEX=^https://your-domain\\.com$
# Dev mode: enables wide CORS and extra logging.
PDGEN_DEV=TRUE

# Render safety (Playwright backend).
# Allow all external network requests (dangerous).
GEMINI_PDF_AGENT_ALLOW_NETWORK=0
# Allow only external images (http/https) while blocking other external requests.
GEMINI_PDF_AGENT_ALLOW_EXTERNAL_IMAGES=0
# Allow JavaScript execution in Playwright.
GEMINI_PDF_AGENT_ALLOW_JS=0

# S3 storage (optional).
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
S3_ENDPOINT_URL=https://s3.ap-northeast-1.amazonaws.com
